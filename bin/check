#!/bin/sh
set -eu
: "${SCHEMA:=CommonMark.rnc}"
spec_dir=vendor/commonmark-spec
guix shell cmark \
     -- cmark \
     --to xml \
     --sourcepos \
     "$spec_dir/spec.txt" \
     > spec.xml
cp "$spec_dir/CommonMark.dtd" .
guix shell openjdk \
     -- java \
     -jar jing-20241231/bin/jing.jar \
     CommonMark.rng \
     spec.xml 
